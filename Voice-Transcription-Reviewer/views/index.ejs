<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shruti-Lekhan — Language Data Collection Platform</title>
  <meta name="description" content="Review and edit audio transcriptions side-by-side with the audio player." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet" />
  <style>
    :root {
      --bg-base: #F8FAFC;
      --bg-surface: #FFFFFF;
      --bg-card: #FFFFFF;
      --bg-card-hover: #F1F5F9;
      --border: #E5E7EB;
      --border-focus: #2473CC;
      --primary: #2473CC;
      --primary-dark: #25408F;
      --accent: #2473CC;
      --accent-dark: #25408F;
      --accent-glow: rgba(36, 115, 204, 0.15);
      --slate-blue: #B9CDDA;
      --mid-orange: #EFB179;
      --dark-blue: #25408F;
      --blue-grey: #669AD5;
      --green: #22C55E;
      --green-dark: #16A34A;
      --green-glow: rgba(34, 197, 94, 0.15);
      --yellow: #F59E0B;
      --red: #EF4444;
      --text-primary: #111827;
      --text-secondary: #4B5563;
      --text-muted: #6B7280;
      --radius-sm: 6px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.03);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Lato', system-ui, -apple-system, sans-serif;
      background: var(--bg-base);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      line-height: 1.6;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    .card-title,
    .header-brand h1 {
      font-family: 'Plus Jakarta Sans', 'Futura', system-ui, sans-serif;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 50% at 20% 10%, rgba(36, 115, 204, 0.04) 0%, transparent 60%),
        radial-gradient(ellipse 60% 40% at 80% 80%, rgba(37, 64, 143, 0.03) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      width: 100%;
      background: #FFFFFF;
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      padding: 0 28px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .header-logo {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      color: #FFFFFF;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(36, 115, 204, 0.25);
    }

    .header-brand-text {
      display: flex;
      flex-direction: column;
    }

    .header-brand h1 {
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: -0.3px;
      color: var(--primary-dark);
      margin: 0;
    }

    .header-tagline {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .header-meta {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .badge {
      padding: 5px 12px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      font-size: 0.78rem;
      color: var(--text-secondary);
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .badge-accent {
      background: #EBF3FC;
      border-color: #B9CDDA;
      color: #2473CC;
      font-weight: 600;
    }

    .badge-admin {
      background: #EEF2FF;
      border-color: #C7D2FE;
      color: #25408F;
      font-weight: 700;
    }

    .badge-verifier {
      background: #DCFCE7;
      border-color: #86EFAC;
      color: #166534;
      font-weight: 600;
    }

    .badge-quota {
      background: #FEF3C7;
      border-color: #FDE68A;
      color: #92400E;
      font-weight: 600;
    }

    .badge-pending {
      background: #FEF3C7;
      border-color: #FDE68A;
      color: #92400E;
    }

    .badge-verified {
      background: #DCFCE7;
      border-color: #86EFAC;
      color: #166534;
    }

    .badge-edited {
      background: #EBF3FC;
      border-color: #B9CDDA;
      color: #2473CC;
    }

    main {
      position: relative;
      z-index: 1;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .page-container {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 32px 24px;
    }

    .glass-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .glass-card:hover {
      border-color: #CBD5E1;
      box-shadow: var(--shadow-lg);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 24px;
      background: #F8FAFC;
      border-bottom: 1px solid var(--border);
      border-top-left-radius: var(--radius-lg);
      border-top-right-radius: var(--radius-lg);
    }

    .card-header-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .card-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      flex-shrink: 0;
    }

    .card-icon-blue {
      background: #EBF3FC;
      color: #2473CC;
    }

    .card-icon-purple {
      background: #EEF2FF;
      color: #25408F;
    }

    .card-icon-green {
      background: #DCFCE7;
      color: #166534;
    }

    .card-title {
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: none;
      letter-spacing: 0.2px;
      color: var(--text-primary);
    }

    /* Login & Cards */
    .login-wrapper {
      max-width: 440px;
      margin: 60px auto 0;
      animation: fadeUp 0.5s ease both;
    }

    .login-hero {
      text-align: center;
      margin-bottom: 28px;
    }

    .login-hero .hero-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      background: linear-gradient(135deg, #EBF3FC, #EEF2FF);
      border: 1px solid #B9CDDA;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      box-shadow: var(--shadow-sm);
    }

    .login-hero h2 {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--primary-dark);
      letter-spacing: -0.4px;
      margin-bottom: 8px;
    }

    .login-hero p {
      color: var(--text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .login-form {
      padding: 28px;
    }

    /* Inputs */
    .field {
      margin-bottom: 20px;
    }

    .field label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-primary);
      text-transform: none;
      letter-spacing: 0.2px;
      margin-bottom: 8px;
    }

    .input-text,
    select.input-text {
      width: 100%;
      padding: 11px 14px;
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-size: 0.9rem;
      color: var(--text-primary);
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-text:focus,
    select.input-text:focus {
      outline: none;
      border-color: var(--border-focus);
      box-shadow: 0 0 0 3px rgba(36, 115, 204, 0.15);
    }

    select.input-text option {
      background: #FFFFFF;
      color: var(--text-primary);
    }

    /* Upload */
    .upload-wrapper {
      max-width: 620px;
      margin: 40px auto 0;
      animation: fadeUp 0.5s ease both;
    }

    .upload-hero {
      text-align: center;
      margin-bottom: 32px;
    }

    .upload-hero .hero-icon {
      width: 72px;
      height: 72px;
      margin: 0 auto 20px;
      background: linear-gradient(135deg, #EBF3FC, #EEF2FF);
      border: 1px solid #B9CDDA;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      box-shadow: var(--shadow-sm);
    }

    .upload-hero h2 {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--primary-dark);
      letter-spacing: -0.5px;
      margin-bottom: 10px;
    }

    .upload-hero p {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .upload-form {
      padding: 28px;
    }

    .file-drop {
      position: relative;
      border: 2px dashed #B9CDDA;
      border-radius: var(--radius-md);
      background: #F8FAFC;
      padding: 24px 20px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
    }

    .file-drop:hover {
      border-color: var(--primary);
      background: #EBF3FC;
    }

    .file-drop input[type="file"] {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%;
    }

    .file-drop-icon {
      font-size: 28px;
      margin-bottom: 8px;
    }

    .file-drop-label {
      font-size: 0.88rem;
      color: var(--text-secondary);
    }

    .file-drop-label strong {
      color: var(--primary);
    }

    .hint {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: 8px;
      line-height: 1.5;
    }

    .alert {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 14px 18px;
      border-radius: var(--radius-md);
      font-size: 0.875rem;
      margin-bottom: 20px;
      box-shadow: var(--shadow-sm);
      animation: fadeUp 0.3s ease both;
    }

    .alert-error {
      background: #FEF2F2;
      border: 1px solid #FCA5A5;
      color: #991B1B;
    }

    .alert-warning {
      background: #FFFBEB;
      border: 1px solid #FDE68A;
      color: #92400E;
    }

    .alert-success {
      background: #F0FDF4;
      border: 1px solid #86EFAC;
      color: #166534;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 10px 20px;
      border: none;
      border-radius: var(--radius-sm);
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
      white-space: nowrap;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-primary {
      background: var(--primary);
      color: #FFFFFF;
      box-shadow: 0 2px 4px rgba(36, 115, 204, 0.2);
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      box-shadow: 0 4px 8px rgba(37, 64, 143, 0.3);
    }

    .btn-verify {
      background: var(--green);
      color: #FFFFFF;
      box-shadow: 0 2px 4px rgba(34, 197, 94, 0.2);
    }

    .btn-verify:hover {
      background: var(--green-dark);
      box-shadow: 0 4px 8px rgba(22, 163, 74, 0.3);
    }

    .btn-save {
      background: #FFFFFF;
      border: 1px solid var(--border);
      color: var(--text-primary);
    }

    .btn-save:hover {
      background: #F1F5F9;
      border-color: #CBD5E1;
    }

    .btn-nav {
      background: #F1F5F9;
      border: 1px solid var(--border);
      color: var(--text-primary);
    }

    .btn-nav:hover {
      background: #E2E8F0;
      border-color: #CBD5E1;
    }

    .btn-nav:disabled,
    .btn-nav[disabled],
    .btn:disabled,
    .btn[disabled] {
      opacity: 0.4;
      cursor: default;
      pointer-events: none;
    }

    .btn-ghost {
      background: #FEF2F2;
      border: 1px solid #FECACA;
      color: #DC2626;
      font-size: 0.8rem;
      padding: 7px 16px;
    }

    .btn-ghost:hover {
      background: #FEE2E2;
    }

    .btn-sm {
      padding: 7px 14px;
      font-size: 0.8rem;
    }

    .btn-header {
      background: #F1F5F9;
      border: 1px solid var(--border);
      color: var(--text-secondary);
    }

    .btn-header:hover {
      background: #E2E8F0;
      color: var(--text-primary);
    }

    /* Trimmer Styles */
    .trimmer-box {
      margin-top: 20px;
      padding: 18px;
      background: #F8FAFC;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
    }

    .trimmer-title {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: none;
      letter-spacing: 0.3px;
      color: var(--primary-dark);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .trimmer-inputs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }

    .trimmer-field label {
      font-size: 0.75rem;
      color: var(--text-secondary);
      display: block;
      margin-bottom: 4px;
      font-weight: 600;
    }

    .trimmer-field input {
      width: 100%;
      padding: 6px 10px;
      font-size: 0.85rem;
    }

    /* Progress & Stats */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
      animation: fadeUp 0.4s ease both;
    }

    @media (max-width: 768px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .stat-card {
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      box-shadow: var(--shadow-sm);
      border-top: 3px solid var(--primary);
    }

    .stat-card:nth-child(2) {
      border-top-color: var(--green);
    }

    .stat-card:nth-child(3) {
      border-top-color: var(--mid-orange);
    }

    .stat-card:nth-child(4) {
      border-top-color: var(--yellow);
    }

    .stat-num {
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--text-primary);
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    }

    .stat-label {
      font-size: 0.78rem;
      color: var(--text-secondary);
      font-weight: 600;
      text-transform: none;
      letter-spacing: 0.2px;
    }

    .progress-section {
      margin-bottom: 28px;
      animation: fadeUp 0.4s ease both;
    }

    .progress-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }

    .progress-meta-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .progress-pct {
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -1px;
      color: var(--primary-dark);
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    }

    .progress-sub {
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    .progress-count {
      font-size: 0.85rem;
      color: var(--text-secondary);
      font-weight: 500;
    }

    .progress-track {
      width: 100%;
      height: 8px;
      background: #E2E8F0;
      border-radius: 4px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--primary-dark));
      border-radius: 4px;
      transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Review grid */
    .review-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      align-items: start;
      animation: fadeUp 0.45s ease both;
    }

    @media (max-width: 860px) {
      .review-grid {
        grid-template-columns: 1fr;
      }
    }

    .audio-panel {
      position: sticky;
      top: 84px;
    }

    .audio-body {
      padding: 24px;
    }

    .audio-file-info {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 20px;
      padding: 12px 14px;
      background: #F8FAFC;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
    }

    .audio-file-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--primary);
      flex-shrink: 0;
      animation: pulse-dot 2s infinite;
    }

    .audio-file-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      color: var(--text-secondary);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .audio-player-wrap {
      width: 100%;
      border-radius: var(--radius-md);
      overflow: hidden;
      background: #F8FAFC;
      border: 1px solid var(--border);
    }

    audio {
      width: 100%;
      display: block;
      height: 48px;
      background: transparent;
      outline: none;
    }

    audio::-webkit-media-controls-panel {
      background: #F1F5F9;
    }

    .audio-shortcuts {
      margin-top: 18px;
    }

    .shortcuts-title {
      font-size: 0.75rem;
      text-transform: none;
      letter-spacing: 0.3px;
      color: var(--text-muted);
      margin-bottom: 10px;
      font-weight: 700;
    }

    .shortcut-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .shortcut-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--text-secondary);
    }

    .kbd {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      padding: 2px 7px;
      background: #F1F5F9;
      border: 1px solid #CBD5E1;
      border-radius: 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--text-primary);
    }

    .no-audio {
      text-align: center;
      padding: 48px 24px;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .no-audio-icon {
      font-size: 36px;
      margin-bottom: 12px;
    }

    .text-body {
      padding: 24px;
    }

    textarea#transcriptionText {
      width: 100%;
      min-height: 260px;
      padding: 16px;
      background: #FFFFFF;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      font-family: 'Lato', system-ui, sans-serif;
      font-size: 0.98rem;
      line-height: 1.7;
      color: var(--text-primary);
      resize: vertical;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    textarea#transcriptionText:focus {
      outline: none;
      border-color: var(--border-focus);
      box-shadow: 0 0 0 3px rgba(36, 115, 204, 0.15);
    }

    textarea#transcriptionText::placeholder {
      color: var(--text-muted);
    }

    .char-count {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-align: right;
      margin-top: 6px;
    }

    .action-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 20px;
      flex-wrap: wrap;
    }

    .action-bar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Users Table */
    .users-wrapper {
      max-width: 1120px;
      margin: 30px auto 0;
      animation: fadeUp 0.5s ease both;
    }

    .table-container {
      width: 100%;
      overflow-x: auto;
      padding: 0 24px 24px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.88rem;
    }

    th {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      color: var(--text-secondary);
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: none;
      letter-spacing: 0.2px;
      background: #F8FAFC;
    }

    td {
      padding: 14px 16px;
      border-bottom: 1px solid #F1F5F9;
      color: var(--text-primary);
      vertical-align: middle;
    }

    /* Empty state */
    .empty-wrapper {
      max-width: 520px;
      margin: 80px auto;
      text-align: center;
      animation: fadeUp 0.5s ease both;
    }

    .empty-icon {
      font-size: 48px;
      margin-bottom: 16px;
    }

    .footer-strip {
      position: relative;
      z-index: 1;
      padding: 14px 28px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #FFFFFF;
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: auto;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pulse-dot {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.3;
      }
    }
  </style>
</head>

<body>

  <header>
    <a href="/" class="header-brand">
      <div class="header-logo">🌐</div>
      <div class="header-brand-text">
        <h1>Shruti-Lekhan</h1>
        <span class="header-tagline">Shruti (Listening) + Lekhan (Writing)</span>
      </div>
    </a>

    <div class="header-nav">
      <% if (user) { %>
        <div class="header-meta">
          <span class="badge badge-accent">👤 <%= user.username %></span>
          <span class="badge <%= user.role === 'admin' ? 'badge-admin' : 'badge-verifier' %>">
            <%= user.role==='admin' ? '⚡ ADMIN' : '✓ VERIFIER' %>
          </span>
          <% if (user.role !=='admin' ) { %>
            <span class="badge badge-quota">
              🎯 Assigned: Records <%= (user.startIndex || 0) + 1 %> – <%= (user.quota> 0) ? ((user.startIndex || 0) +
                  user.quota) : 'All' %> (<%= userVerifiedCount %>/<%= user.quota===0 ? '∞' : user.quota %> verified)
            </span>
            <% } %>
        </div>

        <% if (user.role==='admin' ) { %>
          <a href="/?tab=users" class="btn btn-header btn-sm">👥 Users &amp; Permissions</a>
          <a href="/?tab=upload" class="btn btn-header btn-sm">📤 Upload Dataset</a>
          <a href="/?tab=dataset" class="btn btn-header btn-sm">📊 View Dataset</a>
          <a href="/admin/export-csv" class="btn btn-header btn-sm">📥 Export CSV</a>
          <a href="/admin/export-zip" class="btn btn-header btn-sm">📦 Export Zip Package</a>
        <% } else { %>
          <a href="/?tab=upload" class="btn btn-header btn-sm">📤 Upload Dataset</a>
          <a href="/?tab=dataset" class="btn btn-header btn-sm">📊 View Dataset</a>
        <% } %>

            <a href="/logout" class="btn btn-header btn-sm"
              style="color:#fca5a5;border-color:rgba(239,68,68,0.2);">Logout</a>
            <% } else { %>
              <span class="badge">Please Sign In</span>
              <% } %>
    </div>
  </header>

  <main>
    <% if (mode==='login' ) { %>
      <!-- LOGIN MODE -->
      <div class="page-container">
        <div class="login-wrapper">
          <div class="login-hero">
            <div class="hero-icon">🎧</div>
            <h2>Shruti-Lekhan</h2>
            <p style="margin-top:6px;font-size:0.9rem;color:var(--text-secondary);">
              <strong>Shruti (Listening) + Lekhan (Writing)</strong><br />
              The workbench for transcribing and labeling speech.
            </p>
          </div>

          <% if (error) { %>
            <div class="alert alert-error">⚠️ <%= error %>
            </div>
            <% } %>
              <% if (success) { %>
                <div class="alert alert-success">✅ <%= success %>
                </div>
                <% } %>

                  <div class="glass-card">
                    <form class="login-form" action="/login" method="POST">
                      <div class="field">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" class="input-text"
                          placeholder="Enter your username" required autofocus />
                      </div>

                      <div class="field">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" class="input-text"
                          placeholder="Enter your password" required />
                      </div>

                      <button type="submit" class="btn btn-primary"
                        style="width:100%;justify-content:center;margin-top:8px;">
                        Sign In →
                      </button>
                    </form>
                  </div>

                  <div style="text-align:center;margin-top:20px;font-size:0.78rem;color:var(--text-muted);">

                  </div>
        </div>
      </div>

      <% } else if (mode==='users' ) { %>
        <!-- ADMIN USER, QUOTA & PERMISSION MANAGEMENT MODE -->
        <div class="page-container">
          <div class="users-wrapper">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
              <div>
                <h2 style="font-size:1.5rem;font-weight:700;">User &amp; Permission Management</h2>
                <p style="color:var(--text-secondary);font-size:0.88rem;">Create accounts, set record partitions, and
                  control audio trimming access.</p>
              </div>
              <a href="/" class="btn btn-nav">← Back to Workspace</a>
            </div>

            <% if (error) { %>
              <div class="alert alert-error">⚠️ <%= error %>
              </div>
              <% } %>
                <% if (success) { %>
                  <div class="alert alert-success">✅ <%= success %>
                  </div>
                  <% } %>

                    <!-- Create User Card -->
                    <div class="glass-card" style="margin-bottom:28px;">
                      <div class="card-header">
                        <div class="card-header-left">
                          <div class="card-icon card-icon-purple">➕</div>
                          <span class="card-title">Create New Account</span>
                        </div>
                      </div>
                      <form action="/admin/users/create" method="POST" style="padding:24px;">
                        <div
                          style="display:grid;grid-template-columns: 1.1fr 1fr 1fr 0.8fr 0.8fr auto;gap:12px;align-items:start;">
                          <div class="field" style="margin:0;">
                            <label for="new_username">Username</label>
                            <input type="text" id="new_username" name="username" class="input-text"
                              placeholder="e.g. verifier2" required />
                          </div>
                          <div class="field" style="margin:0;">
                            <label for="new_password">Password</label>
                            <input type="password" id="new_password" name="password" class="input-text"
                              placeholder="Min 4 chars" required />
                          </div>
                          <div class="field" style="margin:0;">
                            <label for="new_role">Role</label>
                            <select id="new_role" name="role" class="input-text">
                              <option value="verifier">Verifier (Regular User)</option>
                              <option value="admin">Admin (Full Control)</option>
                            </select>
                          </div>
                          <div class="field" style="margin:0;">
                            <label for="new_start">Start Record #</label>
                            <input type="number" id="new_start" name="startRecord" class="input-text" min="1"
                              value="<%= typeof nextStartIndex !== 'undefined' ? nextStartIndex + 1 : 1 %>" required />
                            <span class="hint" style="margin-top:4px;display:block;">Auto-assigned</span>
                          </div>
                          <div class="field" style="margin:0;">
                            <label for="new_quota">Quota Count</label>
                            <input type="number" id="new_quota" name="quota" class="input-text" min="0"
                              placeholder="0 = All" value="10" />
                            <span class="hint" style="margin-top:4px;display:block;">0 = Unlimited</span>
                          </div>
                          <div class="field" style="margin:0;padding-top:24px;">
                            <label
                              style="display:flex;align-items:center;gap:6px;font-size:0.8rem;text-transform:none;cursor:pointer;">
                              <input type="checkbox" name="canTrim" value="true" checked
                                style="width:16px;height:16px;" />
                              <span>Allow Audio Trimming</span>
                            </label>
                          </div>
                        </div>
                        <div style="margin-top:18px;text-align:right;">
                          <button type="submit" class="btn btn-primary">Create User Account</button>
                        </div>
                      </form>
                    </div>

                    <!-- Users Table Card -->
                    <div class="glass-card">
                      <div class="card-header">
                        <div class="card-header-left">
                          <div class="card-icon card-icon-blue">📋</div>
                          <span class="card-title">Existing Accounts &amp; Permissions (<%= usersList.length %>)</span>
                        </div>
                      </div>
                      <div class="table-container">
                        <table>
                          <thead>
                            <tr>
                              <th>Username</th>
                              <th>Role</th>
                              <th>Completed</th>
                              <th>Assigned Range</th>
                              <th>Trim Access</th>
                              <th>Update Settings</th>
                              <th>Action</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% usersList.forEach(u=> { %>
                              <tr>
                                <td><strong>
                                    <%= u.username %>
                                  </strong></td>
                                <td>
                                  <span class="badge <%= u.role === 'admin' ? 'badge-admin' : 'badge-verifier' %>">
                                    <%= u.role.toUpperCase() %>
                                  </span>
                                </td>
                                <td>
                                  <span class="badge badge-accent">
                                    <%= u.verifiedCount %> verified
                                  </span>
                                </td>
                                <td>
                                  <% if (u.role==='admin' ) { %>
                                    <span style="color:var(--text-muted);">Full Dataset</span>
                                    <% } else if (u.quota===0) { %>
                                      <span class="badge badge-quota">All Records (Unlimited)</span>
                                      <% } else { %>
                                        <span class="badge badge-quota">
                                          Records <%= (u.startIndex || 0) + 1 %> – <%= (u.startIndex || 0) + u.quota %>
                                        </span>
                                        <% } %>
                                </td>
                                <td>
                                  <% if (u.role==='admin' ) { %>
                                    <span class="badge badge-verified">Full Access</span>
                                    <% } else { %>
                                      <span class="badge <%= u.canTrim ? 'badge-verified' : 'badge-pending' %>">
                                        <%= u.canTrim ? '✂️ Allowed' : '🔒 Disabled' %>
                                      </span>
                                      <% } %>
                                </td>
                                <td>
                                  <% if (u.role !=='admin' ) { %>
                                    <form action="/admin/users/update-quota" method="POST"
                                      style="display:flex;align-items:center;gap:8px;">
                                      <input type="hidden" name="username" value="<%= u.username %>" />
                                      <span style="font-size:0.75rem;color:var(--text-muted);">Start #</span>
                                      <input type="number" name="startRecord" min="1"
                                        value="<%= (u.startIndex || 0) + 1 %>" class="input-text"
                                        style="width:60px;padding:4px 6px;font-size:0.8rem;" />
                                      <span style="font-size:0.75rem;color:var(--text-muted);">Quota</span>
                                      <input type="number" name="quota" min="0" value="<%= u.quota %>"
                                        class="input-text" style="width:60px;padding:4px 6px;font-size:0.8rem;" />
                                      <label
                                        style="display:inline-flex;align-items:center;gap:4px;font-size:0.75rem;cursor:pointer;"
                                        title="Allow user to trim audio">
                                        <input type="checkbox" name="canTrim" value="true" <%=u.canTrim ? 'checked' : ''
                                          %> />
                                        <span>Trim</span>
                                      </label>
                                      <button type="submit" class="btn btn-save btn-sm">Set</button>
                                    </form>
                                    <% } else { %>
                                      <span style="color:var(--text-muted);font-size:0.78rem;">Full Access</span>
                                      <% } %>
                                </td>
                                <td>
                                  <% if (u.username.toLowerCase() !==user.username.toLowerCase()) { %>
                                    <form action="/admin/users/delete" method="POST"
                                      onsubmit="return confirm('Are you sure you want to delete user account &quot;<%= u.username %>&quot;?')">
                                      <input type="hidden" name="username" value="<%= u.username %>" />
                                      <button type="submit" class="btn btn-ghost btn-sm"
                                        style="padding:4px 8px;font-size:0.75rem;">🗑️ Delete</button>
                                    </form>
                                    <% } else { %>
                                      <span style="color:var(--text-muted);font-size:0.78rem;">Active</span>
                                      <% } %>
                                </td>
                              </tr>
                              <% }); %>
                          </tbody>
                        </table>
                      </div>
                    </div>

          </div>
        </div>

        <% } else if (mode==='upload' ) { %>
          <!-- DATASET UPLOAD MODE (SegAUD Format) -->
          <div class="page-container">
            <div class="upload-wrapper">
              <div class="upload-hero">
                <div class="hero-icon">🎵</div>
                <h2>Upload Dataset (SegAUD Format)</h2>
                <p>Upload a SegAUD CSV file (columns: <code>segment_id/voice</code>, <code>transcript</code>, <code>speaker</code>, <code>domain</code>) and corresponding audio files or ZIP archive.
                </p>
              </div>

              <% if (error) { %>
                <div class="alert alert-error">⚠️ <%= error %>
                </div>
                <% } %>
                  <% if (success) { %>
                    <div class="alert alert-success">✅ <%= success %>
                    </div>
                    <% } %>

                      <div class="glass-card">
                        <form class="upload-form" id="uploadForm" action="/upload" method="POST"
                          enctype="multipart/form-data">

                          <div class="field">
                            <label for="csvFile">SegAUD CSV Mapping File</label>
                            <div class="file-drop" id="csvDropZone">
                              <input type="file" id="csvFile" name="csvFile" accept=".csv" required />
                              <div class="file-drop-icon">📄</div>
                              <div class="file-drop-label" id="csvLabel">
                                <strong>Click to choose</strong> or drag &amp; drop<br />
                                <span>Columns: <code>segment_id</code>, <code>transcript</code>, <code>speaker</code>, <code>domain</code></span>
                              </div>
                            </div>
                            <p class="hint">SegAUD format: "segment_id" or "voice", and "transcript" or "orthographic_transcription"</p>
                          </div>

                          <div class="field">
                            <label for="audioFiles">Audio Files / ZIP</label>
                            <div class="file-drop" id="audioDropZone">
                              <input type="file" id="audioFiles" name="audioFiles"
                                accept=".wav,.mp3,.ogg,.m4a,.flac,.zip" multiple />
                              <div class="file-drop-icon">🎵</div>
                              <div class="file-drop-label" id="audioLabel">
                                <strong>Click to choose</strong> or drag &amp; drop<br />
                                <span>.wav .mp3 .ogg .m4a .flac — or a single .zip</span>
                              </div>
                            </div>
                            <p class="hint">ZIP archives will be extracted automatically into the uploads directory.</p>
                          </div>

                          <div class="action-bar" style="margin-top:8px;">
                            <button type="submit" id="uploadBtn" class="btn btn-primary"
                              style="width:100%;justify-content:center;">
                              Upload Dataset &amp; Initialize Review →
                            </button>
                          </div>

                        </form>
                      </div>
            </div>
          </div>

          <% } else if (mode==='dataset' ) { %>
            <!-- VIEW DATASET MODE -->
            <div class="page-container">

              <% if (typeof records !== 'undefined' && records.length > 0) { %>

              <!-- Dataset Stats -->
              <div class="stats-grid" style="margin-bottom:20px;">
                <div class="stat-card">
                  <span class="stat-num" style="color:var(--accent);"><%= datasetStats.total %></span>
                  <span class="stat-label">Total Records</span>
                </div>
                <div class="stat-card">
                  <span class="stat-num" style="color:var(--green);"><%= datasetStats.verified %></span>
                  <span class="stat-label">Verified ✅</span>
                </div>
                <div class="stat-card">
                  <span class="stat-num" style="color:var(--accent);"><%= datasetStats.edited %></span>
                  <span class="stat-label">Edited ✏️</span>
                </div>
                <div class="stat-card">
                  <span class="stat-num" style="color:var(--yellow);"><%= datasetStats.pending %></span>
                  <span class="stat-label">Pending ⏳</span>
                </div>
              </div>

              <!-- Search & Filter Bar -->
              <div class="glass-card" style="padding:12px 16px;margin-bottom:16px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
                <div style="flex:1;min-width:200px;">
                  <input type="text" id="datasetSearch" class="input-text" placeholder="🔍 Search transcriptions, speakers, domains..." style="width:100%;margin:0;" oninput="filterDatasetTable()">
                </div>
                <div style="display:flex;gap:8px;align-items:center;">
                  <select id="statusFilter" class="input-text" style="width:auto;min-width:120px;margin:0;" onchange="filterDatasetTable()">
                    <option value="all">All Status</option>
                    <option value="verified">✅ Verified</option>
                    <option value="edited">✏️ Edited</option>
                    <option value="pending">⏳ Pending</option>
                  </select>
                  <span id="filteredCount" class="badge" style="white-space:nowrap;"><%= records.length %> records</span>
                </div>
              </div>

              <!-- Dataset Table -->
              <div class="glass-card" style="padding:0;overflow:hidden;">
                <div style="overflow-x:auto;max-height:65vh;overflow-y:auto;">
                  <table class="dataset-table" id="datasetTable">
                    <thead style="position:sticky;top:0;z-index:2;">
                      <tr>
                        <th style="width:50px;text-align:center;">#</th>
                        <th style="width:60px;text-align:center;">Play</th>
                        <th style="min-width:140px;">Audio File</th>
                        <th style="min-width:250px;">Transcription</th>
                        <th style="min-width:100px;">Speaker</th>
                        <th style="min-width:100px;">Domain</th>
                        <th style="width:90px;text-align:center;">Status</th>
                        <th style="min-width:100px;">Verified By</th>
                        <th style="min-width:140px;">Updated</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% records.forEach(function(rec, i) { %>
                      <tr class="dataset-row" data-status="<%= rec.status || 'pending' %>" data-search="<%= (rec.transcription || '').toLowerCase() %> <%= (rec.normalizedTranscription || '').toLowerCase() %> <%= (rec.speaker || '').toLowerCase() %> <%= (rec.domain || '').toLowerCase() %> <%= (rec.voice || '').toLowerCase() %>">
                        <td style="text-align:center;color:var(--text-muted);font-size:0.8rem;"><%= i + 1 %></td>
                        <td style="text-align:center;">
                          <% if (rec.voice) { %>
                          <button class="btn btn-sm dataset-play-btn" onclick="toggleDatasetAudio(this, '/uploads/<%= rec.voice %>')" title="Play audio" style="padding:4px 8px;min-width:0;">
                            ▶️
                          </button>
                          <% } else { %>
                          <span style="color:var(--text-muted);font-size:0.75rem;">—</span>
                          <% } %>
                        </td>
                        <td style="font-size:0.8rem;word-break:break-all;color:var(--text-secondary);"><%= rec.voice || '—' %></td>
                        <td style="font-size:0.85rem;line-height:1.4;">
                          <div style="max-height:3.6em;overflow:hidden;text-overflow:ellipsis;" title="<%= rec.transcription || '' %>">
                            <%= rec.transcription || rec.normalizedTranscription || '—' %>
                          </div>
                        </td>
                        <td><span class="badge" style="font-size:0.75rem;"><%= rec.speaker || '—' %></span></td>
                        <td><span class="badge badge-accent" style="font-size:0.75rem;"><%= rec.domain || '—' %></span></td>
                        <td style="text-align:center;">
                          <% if (rec.status === 'verified') { %>
                            <span style="color:var(--green);font-weight:600;font-size:0.8rem;">✅</span>
                          <% } else if (rec.status === 'edited') { %>
                            <span style="color:var(--accent);font-weight:600;font-size:0.8rem;">✏️</span>
                          <% } else { %>
                            <span style="color:var(--yellow);font-weight:600;font-size:0.8rem;">⏳</span>
                          <% } %>
                        </td>
                        <td style="font-size:0.8rem;color:var(--text-secondary);"><%= rec.verifiedBy || '—' %></td>
                        <td style="font-size:0.75rem;color:var(--text-muted);"><%= rec.updatedAt ? new Date(rec.updatedAt).toLocaleString() : '—' %></td>
                      </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>

              <% } else { %>
              <!-- No records -->
              <div class="glass-card" style="padding:40px;text-align:center;">
                <div style="font-size:3rem;margin-bottom:16px;">📂</div>
                <h2 style="font-size:1.3rem;margin-bottom:8px;">No Dataset Loaded</h2>
                <p style="color:var(--text-secondary);font-size:0.9rem;margin-bottom:20px;">
                  Upload a SegAUD dataset to view records here.
                </p>
                <a href="/?tab=upload" class="btn btn-primary">📤 Upload Dataset</a>
              </div>
              <% } %>

            </div>

            <style>
              .dataset-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 0.88rem;
              }
              .dataset-table thead {
                background: var(--card-bg);
                border-bottom: 2px solid var(--border);
              }
              .dataset-table th {
                padding: 10px 12px;
                text-align: left;
                font-weight: 600;
                font-size: 0.78rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-secondary);
              }
              .dataset-table td {
                padding: 8px 12px;
                border-bottom: 1px solid var(--border);
                vertical-align: middle;
              }
              .dataset-row {
                transition: background 0.15s;
              }
              .dataset-row:hover {
                background: rgba(99, 102, 241, 0.06);
              }
              .dataset-row.hidden-row {
                display: none;
              }
              .dataset-play-btn {
                background: rgba(99, 102, 241, 0.1) !important;
                border: 1px solid rgba(99, 102, 241, 0.2) !important;
                border-radius: 50% !important;
                width: 32px !important;
                height: 32px !important;
                display: inline-flex !important;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                font-size: 0.85rem;
              }
              .dataset-play-btn:hover {
                background: rgba(99, 102, 241, 0.2) !important;
              }
              .dataset-play-btn.playing {
                background: rgba(239, 68, 68, 0.15) !important;
                border-color: rgba(239, 68, 68, 0.3) !important;
              }
            </style>

            <script>
              // Dataset audio player
              let currentDatasetAudio = null;
              let currentDatasetBtn = null;

              function toggleDatasetAudio(btn, src) {
                if (currentDatasetAudio && currentDatasetBtn === btn) {
                  currentDatasetAudio.pause();
                  currentDatasetAudio = null;
                  btn.textContent = '▶️';
                  btn.classList.remove('playing');
                  currentDatasetBtn = null;
                  return;
                }
                if (currentDatasetAudio) {
                  currentDatasetAudio.pause();
                  if (currentDatasetBtn) {
                    currentDatasetBtn.textContent = '▶️';
                    currentDatasetBtn.classList.remove('playing');
                  }
                }
                currentDatasetAudio = new Audio(src);
                currentDatasetBtn = btn;
                btn.textContent = '⏹️';
                btn.classList.add('playing');
                currentDatasetAudio.play();
                currentDatasetAudio.onended = function() {
                  btn.textContent = '▶️';
                  btn.classList.remove('playing');
                  currentDatasetAudio = null;
                  currentDatasetBtn = null;
                };
              }

              // Search & Filter
              function filterDatasetTable() {
                const query = document.getElementById('datasetSearch').value.toLowerCase().trim();
                const statusFilter = document.getElementById('statusFilter').value;
                const rows = document.querySelectorAll('.dataset-row');
                let visibleCount = 0;

                rows.forEach(function(row) {
                  const searchData = row.getAttribute('data-search') || '';
                  const rowStatus = row.getAttribute('data-status') || 'pending';
                  const matchesSearch = !query || searchData.includes(query);
                  const matchesStatus = statusFilter === 'all' || rowStatus === statusFilter;

                  if (matchesSearch && matchesStatus) {
                    row.classList.remove('hidden-row');
                    visibleCount++;
                  } else {
                    row.classList.add('hidden-row');
                  }
                });

                document.getElementById('filteredCount').textContent = visibleCount + ' record' + (visibleCount !== 1 ? 's' : '');
              }
            </script>

