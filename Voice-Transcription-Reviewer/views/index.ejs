              </div>

              <script>
                const audio = document.getElementById('audioPlayer');
                const trimStart = document.getElementById('trimStart');
                const trimEnd = document.getElementById('trimEnd');

                if (audio) {
                  audio.addEventListener('loadedmetadata', () => {
                    if (trimEnd && !trimEnd.value) {
                      trimEnd.value = audio.duration.toFixed(1);
                    }
                  });
                }

                function setTrimStartCurrent() {
                  if (audio && trimStart) {
                    trimStart.value = audio.currentTime.toFixed(1);
                  }
                }

                function setTrimEndCurrent() {
                  if (audio && trimEnd) {
                    trimEnd.value = audio.currentTime.toFixed(1);
                  }
                }

                function previewTrimmed() {
                  if (!audio) return;
                  const start = parseFloat(trimStart.value) || 0;
                  const end = parseFloat(trimEnd.value) || audio.duration;
                  audio.currentTime = start;
                  audio.play();

                  const checkStop = () => {
                    if (audio.currentTime >= end) {
                      audio.pause();
                      audio.removeEventListener('timeupdate', checkStop);
                    }
                  };
                  audio.addEventListener('timeupdate', checkStop);
                }

                function bufferToWav(abuffer) {
                  const numOfChan = abuffer.numberOfChannels;
                  const length = abuffer.length * numOfChan * 2 + 44;
                  const buffer = new ArrayBuffer(length);
                  const view = new DataView(buffer);
                  const channels = [];
                  let sampleRate = abuffer.sampleRate;
                  let offset = 0;
                  let pos = 0;

                  function writeString(str) {
                    for (let i = 0; i < str.length; i++) {
                      view.setUint8(pos++, str.charCodeAt(i));
                    }
                  }
                  function setUint16(data) { view.setUint16(pos, data, true); pos += 2; }
                  function setUint32(data) { view.setUint32(pos, data, true); pos += 4; }

                  writeString('RIFF');
                  setUint32(length - 8);
                  writeString('WAVE');
                  writeString('fmt ');
                  setUint32(16);
                  setUint16(1);
                  setUint16(numOfChan);
                  setUint32(sampleRate);
                  setUint32(sampleRate * 2 * numOfChan);
                  setUint16(numOfChan * 2);
                  setUint16(16);
                  writeString('data');
                  setUint32(length - pos - 4);

                  for (let i = 0; i < abuffer.numberOfChannels; i++) {
                    channels.push(abuffer.getChannelData(i));
                  }

                  while (offset < abuffer.length) {
                    for (let i = 0; i < numOfChan; i++) {
                      let sample = Math.max(-1, Math.min(1, channels[i][offset]));
                      sample = (0.5 + sample < 0 ? sample * 32768 : sample * 32767) | 0;
                      view.setInt16(pos, sample, true);
                      pos += 2;
                    }
                    offset++;
                  }
                  return buffer;
                }

                async function executeTrimAndSave() {
                  if (!confirm("Are you sure you want to trim and overwrite the original file? This cannot be undone. Click on Preview Segment for listening the trimmed segment.")) {
                    return;
                  }
                  if (!audio) return;
                  const trimBtn = document.getElementById('trimSaveBtn');
                  const start = parseFloat(trimStart.value) || 0;
                  const end = parseFloat(trimEnd.value) || audio.duration;

                  if (end <= start) {
                    alert('End time must be greater than start time.');
                    return;
                  }

                  try {
                    trimBtn.disabled = true;
                    trimBtn.textContent = 'Trimming…';

                    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    const response = await fetch(audio.src);
                    const arrayBuffer = await response.arrayBuffer();
                    const decodedBuffer = await audioCtx.decodeAudioData(arrayBuffer);

                    const sampleRate = decodedBuffer.sampleRate;
                    const startSample = Math.floor(start * sampleRate);
                    const endSample = Math.min(decodedBuffer.length, Math.floor(end * sampleRate));
                    const newLength = endSample - startSample;

                    if (newLength <= 0) {
                      throw new Error('Invalid sample range for trimming.');
                    }

                    const trimmedBuffer = audioCtx.createBuffer(
                      decodedBuffer.numberOfChannels,
                      newLength,
                      sampleRate
                    );

                    for (let c = 0; c < decodedBuffer.numberOfChannels; c++) {
                      const origData = decodedBuffer.getChannelData(c);
                      const trimmedData = trimmedBuffer.getChannelData(c);
                      for (let i = 0; i < newLength; i++) {
                        trimmedData[i] = origData[startSample + i];
                      }
                    }

                    const wavArrayBuffer = bufferToWav(trimmedBuffer);
                    const blob = new Blob([wavArrayBuffer], { type: 'audio/wav' });

                    const formData = new FormData();
                    formData.append('idx', '<%= idx %>');
                    formData.append('audioFiles', blob, '<%= record ? record.voice : "audio.wav" %>');

                    const saveRes = await fetch('/trim-audio', {
                      method: 'POST',
                      body: formData
                    });

                    const resJson = await saveRes.json();
                    if (resJson.success) {
                      window.location.href = `/?idx=<%= idx %>&success=` + encodeURIComponent(`Audio "${resJson.voice || ''}" trimmed successfully!`);
                    } else {
                      alert('⚠️ Trimming error: ' + (resJson.error || 'Failed to save trimmed audio'));
                    }
                  } catch (err) {
                    console.error(err);
                    alert('⚠️ Failed to trim audio: ' + err.message);
                  } finally {
                    if (trimBtn) {
                      trimBtn.disabled = false;
                      trimBtn.textContent = '✂️ Trim & Save File';
                    }
                  }
                }

                function copyFromOrthographic() {
                  const srcTa = document.getElementById('transcriptionText');
                  const targetTa = document.getElementById('normalizedText');
                  const targetCounter = document.getElementById('normCharNum');
                  if (srcTa && targetTa) {
                    targetTa.value = srcTa.value;
                    if (targetCounter) targetCounter.textContent = targetTa.value.length;
                  }
                }

                const ta = document.getElementById('transcriptionText');
                const charNum = document.getElementById('charNum');
                if (ta && charNum) {
                  ta.addEventListener('input', () => { charNum.textContent = ta.value.length; });
                }

                const normTa = document.getElementById('normalizedText');
                const normCharNum = document.getElementById('normCharNum');
                if (normTa && normCharNum) {
                  normTa.addEventListener('input', () => { normCharNum.textContent = normTa.value.length; });
                }
                const saveFormEl = document.getElementById('saveForm');
                if (saveFormEl) {
                  saveFormEl.addEventListener('submit', (e) => {
                    const action = document.getElementById('actionField').value;
                    if (action === 'verify') {
                      const orthoVal = (document.getElementById('transcriptionText')?.value || '').trim();
                      const normVal = (document.getElementById('normalizedText')?.value || '').trim();

                      const missing = [];
                      if (!orthoVal) missing.push('orthographic_transcription');
                      if (!normVal) missing.push('normalized_transcription');

                      const metadataSelects = document.querySelectorAll('[form="saveForm"]');
                      let missingMeta = 0;
                      metadataSelects.forEach(sel => {
                        if (!sel.value || !sel.value.trim()) {
                          missingMeta++;
                          sel.style.borderColor = '#ef4444';
                        } else {
                          sel.style.borderColor = '';
                        }
                      });

                      if (missingMeta > 0) {
                        missing.push(`Audio Metadata (${missingMeta} field${missingMeta > 1 ? 's' : ''} missing)`);
                      }

                      if (missing.length > 0) {
                        e.preventDefault();
                        alert('⚠️ Cannot mark as verified!\n\nThe following section(s) must be filled out:\n- ' + missing.join('\n- '));
                        return false;
                      }
                    }
                  });
                }

                document.addEventListener('keydown', (e) => {
                  const inTextarea = document.activeElement === ta || document.activeElement === normTa;
                  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                    e.preventDefault();
                    document.getElementById('actionField').value = 'verify';
                    if (saveFormEl && saveFormEl.requestSubmit) {
                      saveFormEl.requestSubmit();
                    } else if (saveFormEl) {
                      saveFormEl.submit();
                    }
                  }
                  if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                    e.preventDefault();
                    document.getElementById('actionField').value = 'save';
                    if (saveFormEl && saveFormEl.requestSubmit) {
                      saveFormEl.requestSubmit();
                    } else if (saveFormEl) {
                      saveFormEl.submit();
                    }
                  }
                  if (e.altKey && e.key === 'ArrowLeft') {
                    const prev = document.getElementById('prevBtn');
                    if (prev && prev.href) prev.click();
                  }
                  if (e.altKey && e.key === 'ArrowRight') {
                    const next = document.getElementById('nextBtn');
                    if (next && next.href) next.click();
                  }
                  if (e.key === ' ' && !inTextarea && document.activeElement.tagName !== 'INPUT') {
                    e.preventDefault();
                    if (audio) audio.paused ? audio.play() : audio.pause();
                  }
                });
              </script>

              <% } %>
  </main>

  <footer class="footer-strip">
    <span>Shruti-Lekhan — Shruti (Listening) + Lekhan (Writing) | Speech Workbench</span>
    <% if (user) { %>
      <span>Logged in as <strong>
          <%= user.username %>
        </strong> (<%= user.role %>)</span>
      <% } %>
  </footer>

  <% if (mode==='upload' ) { %>
    <script>
      function labelUpdater(inputId, labelId, defaultHtml) {
        const input = document.getElementById(inputId);
        const label = document.getElementById(labelId);
        if (!input || !label) return;
        input.addEventListener('change', () => {
          if (input.files.length > 0) {
            const names = Array.from(input.files).map(f => f.name).join(', ');
            label.innerHTML = '<strong style="color:var(--green)">✓ ' + input.files.length + ' file(s) selected</strong><br/><span style="font-size:0.72rem;color:var(--text-muted)">' + (names.length > 60 ? names.slice(0, 60) + '…' : names) + '</span>';
          } else {
            label.innerHTML = defaultHtml;
          }
        });
      }
      labelUpdater('csvFile', 'csvLabel', '<strong>Click to choose</strong> or drag &amp; drop<br/><span>Columns: <code>voice</code>, <code>orthographic_transcription</code>, <code>normalized_transcription</code></span>');
      labelUpdater('audioFiles', 'audioLabel', '<strong>Click to choose</strong> or drag &amp; drop<br/><span>.wav .mp3 .ogg .m4a .flac — or a single .zip</span>');
      document.getElementById('uploadForm').addEventListener('submit', function () {
        const btn = document.getElementById('uploadBtn');
        btn.textContent = 'Uploading & Processing…';
        btn.disabled = true;
        btn.style.opacity = '0.7';
      });
    </script>
    <% } %>


  <script>
    async function revertAudio(idx) {
      if (!confirm('Revert this audio clip to its original untrimmed version?')) return;
      const btn = document.getElementById('revertAudioBtn');
      if (btn) btn.disabled = true;
      try {
        const res = await fetch('/revert-audio', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ idx })
        });
        const data = await res.json();
        if (data.success) {
          alert('✓ ' + (data.message || 'Audio reverted to original version!'));
          const audioEl = document.getElementById('audioPlayer');
          if (audioEl) {
            const curSrc = audioEl.src.split('?')[0];
            audioEl.src = curSrc + '?t=' + Date.now();
            audioEl.load();
          } else {
            location.reload();
          }
        } else {
          alert('⚠️ ' + (data.error || 'Failed to revert audio'));
        }
      } catch (err) {
        alert('⚠️ Error reverting audio: ' + err.message);
      } finally {
        if (btn) btn.disabled = false;
      }
    }

    async function revertRecord(idx) {
      if (!confirm('Revert this record to its original baseline transcription and audio data?')) return;
      try {
        const res = await fetch('/revert-record', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ idx })
        });
        const data = await res.json();
        if (data.success) {
          alert('✓ ' + (data.message || 'Record reverted!'));
          location.reload();
        } else {
          alert('⚠️ ' + (data.error || 'Failed to revert record'));
        }
      } catch (err) {
        alert('⚠️ Error reverting record: ' + err.message);
      }
    }

    async function revertAllDataset() {
      if (!confirm('⚠️ WARNING: This will revert the ENTIRE dataset (all records and audio files) back to the original baseline state. All edits and trimming will be rolled back. Continue?')) return;
      try {
        const res = await fetch('/revert-all', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) {
          alert('✓ ' + (data.message || 'Entire dataset reverted to baseline!'));
          location.reload();
        } else {
          alert('⚠️ ' + (data.error || 'Failed to revert dataset'));
        }
      } catch (err) {
        alert('⚠️ Error reverting dataset: ' + err.message);
      }
    }
  </script>

</body>

</html>